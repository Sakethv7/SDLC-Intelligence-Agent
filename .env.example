# Anthropic / Claude (direct API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitLab AI Gateway (optional — routes Anthropic calls through GitLab's AI infrastructure)
# Set GITLAB_AI_GATEWAY_URL to enable; leave blank to use direct Anthropic API.
# For GitLab.com: https://cloud.gitlab.com/ai/v1
# For self-hosted: https://<your-gitlab-instance>/ai/v1
GITLAB_AI_GATEWAY_URL=
GITLAB_AI_GATEWAY_TOKEN=your_gitlab_personal_access_token

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=your_project_id
GITLAB_GROUP_ID=your_group_id

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL_ALERTS=https://hooks.slack.com/services/...
SLACK_USER_ID=U0XXXXXXX

# Sprint / Digest config
SPRINT_LABEL=sprint-current
SPRINT_WEEKS=1

# Security Agent RAG
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
POLICY_DOCS_DIR=./policy_docs

# Google Cloud (optional — enables Cloud Run deployment and GCS report storage)
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET=your_gcs_bucket_name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Green Agent — token usage log path (default: token_usage.jsonl)
TOKEN_USAGE_LOG=token_usage.jsonl

# Server
PORT=8080
GITLAB_WEBHOOK_SECRET=change_me
